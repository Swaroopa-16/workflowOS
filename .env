# WorkFlowOS Environment Configuration

# xAI Grok API Key (https://console.x.ai/)
XAI_API_KEY=

# GroqCloud API Key (https://console.groq.com/)
GROQ_API_KEY=

# OpenAI API Key (optional fallback)
OPENAI_API_KEY=

# Preferred AI Model (e.g. grok-2-latest, grok-beta, llama-3.3-70b-versatile)
AI_MODEL=grok-2-latest
